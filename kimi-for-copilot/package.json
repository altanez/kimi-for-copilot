{
  "name": "kimi-for-copilot",
  "displayName": "Kimi for Copilot Chat",
  "description": "Pick Kimi models from the Copilot Chat model picker via local proxy",
  "icon": "icon.png",
  "version": "0.1.0",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": ["AI", "Chat"],
  "keywords": ["kimi", "moonshot", "copilot", "chat"],
  "activationEvents": ["*"],
  "main": "./extension.js",
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "kimi",
        "displayName": "Kimi"
      }
    ],
    "configuration": {
      "title": "Kimi Copilot",
      "properties": {
        "kimi-copilot.baseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8787",
          "description": "Kimi proxy base URL"
        },
        "kimi-copilot.apiKey": {
          "type": "string",
          "default": "kimi-key",
          "description": "API key (passed to proxy)"
        }
      }
    }
  }
}
